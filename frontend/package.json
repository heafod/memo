{
  "name": "memo-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Memo 生产前端（R16）：Vite + React + TypeScript + Tailwind CSS + shadcn/ui + TanStack Query。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0 && node scripts/check-tokens.mjs",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "cd ../backend && uv run python -m app.export_openapi ../frontend/openapi.json && cd ../frontend && openapi-typescript openapi.json -o src/lib/api/schema.d.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "3.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "i18next": "^26.5.3",
    "lucide-react": "^1.60.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router": "^8.5.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4"
  }
}
