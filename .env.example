# Memo 环境变量示例：cp .env.example .env 后逐项填写（.env 不入库）。
# 本文件只含占位值——不是可用密码；未改动的占位值会被拒绝：
#   - 非 development 环境下 SECRET_KEY / POSTGRES_PASSWORD 为 changethis 时 backend 拒绝启动；
#   - FIRST_SUPERUSER / FIRST_SUPERUSER_PASSWORD 为空或密码不符策略时 prestart 中文报错并退出。

# 本地非容器开发（uv run fastapi dev）时生效；compose 部署由 compose.yml / compose.override.yml 决定
FASTAPI_ENV=development

PROJECT_NAME="Memo"

# 会话签名密钥。生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changethis

# PostgreSQL（compose 的 db 服务与 DATABASE_URL 共用）
POSTGRES_PASSWORD=changethis
# 本地非容器开发连接串；compose 内 backend / prestart 自动改写为 db:5432
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# 管理员初始账号（R12）：prestart 仅在账号不存在时创建，之后改密不会被覆盖。
# 必填；密码至少 10 位且须含数字或符号。
FIRST_SUPERUSER=
FIRST_SUPERUSER_PASSWORD=

# 前端（nginx）对外端口，浏览器访问 http://localhost:${FRONTEND_PORT}
FRONTEND_PORT=8080
